# Supabase Configuration (Replace with your own project credentials)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key-here

# Optional CAPTCHA: set the public site key, then enable Turnstile in Supabase Auth.
# The corresponding secret belongs ONLY in Supabase's CAPTCHA settings.
VITE_TURNSTILE_SITE_KEY=

# Cloudflare R2 Media CDN Configuration (Replace with your own R2 public domain & endpoint)
VITE_R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev
VITE_R2_ENDPOINT=https://xxxxxx.r2.cloudflarestorage.com
VITE_R2_BUCKET=wavr-media
